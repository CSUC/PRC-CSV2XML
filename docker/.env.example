# Variables d'entorn per Docker Compose
# Copia aquest fitxer a .env i personalitza els valors

# Versió de l'aplicació
VERSION=2.4.19

# Timestamps de build (s'auto-generen en construir)
BUILD_DATE=
VCS_REF=

# UID/GID per executar el contenidor (opcional)
# Si no s'especifica, s'executa com a root (0:0)
# Per executar amb el teu usuari: DOCKER_UID=$(id -u) DOCKER_GID=$(id -g)
DOCKER_UID=0
DOCKER_GID=0

# Recursos de memòria per Spark (si vols canviar els defaults)
# SPARK_DRIVER_MEMORY=4g
# JAVA_HEAP_SIZE=4g
